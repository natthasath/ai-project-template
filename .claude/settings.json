{
  "model": "claude-sonnet-4-6",
  "theme": "dark",

  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(vite:*)",
      "Bash(vitest:*)",
      "Bash(playwright:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(rm -rf /*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[Hook:PreBash] About to run a shell command\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[Hook:PostEdit] File changed — update tasks/in_progress/current_sprint.md if this completes a task\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[Hook:PostBash] Command finished\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[Hook:Stop] Session ending — check tasks/in_progress/current_sprint.md for incomplete work\""
          }
        ]
      }
    ]
  },

  "env": {
    "NODE_ENV": "development",
    "VITE_APP_NAME": "Pomodoro",
    "VITE_DEFAULT_WORK_DURATION": "25",
    "VITE_DEFAULT_SHORT_BREAK": "5",
    "VITE_DEFAULT_LONG_BREAK": "15"
  }
}
